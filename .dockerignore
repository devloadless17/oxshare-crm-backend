# What must NEVER reach the image, and why.
#
# `.env` carries the four JWT secrets, APP_ENCRYPTION_KEY and the live R2
# credentials; `uploads/` is real client KYC documents. Both are gitignored for
# exactly that reason, and a `COPY . .` would put them in a registry that is not
# the local disk. app.module.ts sets `ignoreEnvFile` in production as the second
# lock on the same door.
.env
.env.*
!.env.example
uploads/

# Build inputs, not build outputs: node_modules is the host's tree (wrong libc,
# wrong ABI if the host runs a different Node) and would land on top of the
# container's own `npm ci`. `nest build` does not clean dist/, so a stale local
# build would survive alongside the fresh one.
node_modules/
dist/
coverage/
*.tsbuildinfo

.git/
.github/
.husky/
.claude/

# Testcontainers suites and their fixtures — CI runs them, the runtime image has
# no use for them and they pull devDependencies into the build context.
test/
**/*.spec.ts

# 415 KB regenerated by `npm run gen:openapi`; the image builds it if it needs it.
openapi.json

docker-compose.yml
docker-compose.prod.yml
Dockerfile
.dockerignore
Caddyfile
README.md
CLAUDE.md
