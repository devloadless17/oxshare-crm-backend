{
  "kyc": {
    "moduleName": "KYC & Verification",
    "description": "Dynamic KYC field builder, document review, and status verification",
    "permissions": [
      {
        "key": "kyc.view",
        "label": "View KYC Fields & Submissions"
      },
      {
        "key": "kyc.create",
        "label": "Create Dynamic KYC Fields"
      },
      {
        "key": "kyc.edit",
        "label": "Edit Dynamic KYC Fields"
      },
      {
        "key": "kyc.delete",
        "label": "Delete Dynamic KYC Fields"
      },
      {
        "key": "kyc.documents.view",
        "label": "View Submitted Documents"
      },
      {
        "key": "kyc.review",
        "label": "Approve / Reject Submissions"
      }
    ]
  },
  "users": {
    "moduleName": "User & Admin Management",
    "description": "Client management, Admin user creation, and role assignments",
    "permissions": [
      {
        "key": "users.view",
        "label": "View Clients & Admins List"
      },
      {
        "key": "users.create",
        "label": "Add New Admins"
      },
      {
        "key": "users.edit",
        "label": "Edit User Profiles & Roles"
      },
      {
        "key": "users.suspend",
        "label": "Suspend / Activate Accounts"
      },
      {
        "key": "users.scope",
        "label": "Set Client-Tag Scope & Field Masking for an Admin"
      }
    ]
  },
  "roles": {
    "moduleName": "Role & Permissions Config",
    "description": "Manage dynamic RBAC roles and permission assignments",
    "permissions": [
      {
        "key": "roles.view",
        "label": "View Roles & Permission Matrix"
      },
      {
        "key": "roles.manage",
        "label": "Create, Edit & Delete Custom Roles"
      }
    ]
  },
  "settings": {
    "moduleName": "Settings",
    "description": "Operational settings shown to clients, such as the trading terminal download links.",
    "permissions": [
      {
        "key": "settings.view",
        "label": "View settings"
      },
      {
        "key": "settings.manage",
        "label": "Change settings"
      }
    ]
  },
  "tags": {
    "moduleName": "Client Tags & Segmentation",
    "description": "Arbitrary client labels (ADM-14) and the tag filters on the client list",
    "permissions": [
      {
        "key": "tags.view",
        "label": "View Tags & Client Tag Assignments"
      },
      {
        "key": "tags.manage",
        "label": "Create, Rename & Delete Tags"
      },
      {
        "key": "tags.assign",
        "label": "Assign / Unassign Tags on a Client"
      }
    ]
  },
  "ib": {
    "moduleName": "Partners & IB",
    "description": "Introducing-broker levels, applications and the partner network",
    "permissions": [
      {
        "key": "ib.view",
        "label": "View Partners & Applications"
      },
      {
        "key": "ib.manage",
        "label": "Configure IB Levels & Partner Records"
      },
      {
        "key": "ib.approve",
        "label": "Approve Partner Applications"
      },
      {
        "key": "ib.reject",
        "label": "Reject Partner Applications"
      }
    ]
  },
  "withdrawals": {
    "moduleName": "Withdrawals & Payouts",
    "description": "Reviewing and paying out client withdrawal requests. Approve and settle are SEPARATE keys on purpose (R-5.4): approval says a payout may be released, settlement releases it. While both required the same permission, 'two people must be involved in a payout' was unexpressible — one admin could authorise their own instruction and pay it out in the same minute, with the audit log showing one name on both rows.",
    "permissions": [
      {
        "key": "withdrawals.view",
        "label": "View Withdrawal Requests"
      },
      {
        "key": "withdrawals.approve",
        "label": "Approve / Reject Withdrawals"
      },
      {
        "key": "withdrawals.settle",
        "label": "Mark Withdrawals Paid"
      }
    ]
  },
  "payments": {
    "moduleName": "Payment Methods",
    "description": "How clients can put money in — the methods offered on the deposit screen, their instructions, and the account details money is sent to.",
    "permissions": [
      {
        "key": "payments.view",
        "label": "View Payment Methods"
      },
      {
        "key": "payments.manage",
        "label": "Add / Edit Payment Methods"
      }
    ]
  }
}
