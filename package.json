{
  "name": "backend",
  "version": "0.0.1",
  "description": "OxShare CRM NestJS API",
  "author": "OxShare",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "dev:crosshost": "PORT=3011 REALTIME_PORT=3013 PORTAL_URL=http://portal.crm.localhost:3010 ADMIN_URL=http://admin.crm.localhost:3012 nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=.vitest-result.json && node scripts/assert-suite-complete.mjs",
    "r2:verify": "node scripts/r2-verify.mjs",
    "assistant:eval": "node scripts/assistant-eval.mjs",
    "seed:volume": "node scripts/seed-volume.mjs",
    "r2:reconcile": "node scripts/r2-reconcile.mjs",
    "r2:e2e": "node scripts/r2-e2e.mjs",
    "r2:e2e:assets": "node scripts/r2-e2e-assets.mjs",
    "gen:openapi": "npm run build && node scripts/gen-openapi.mjs",
    "check:openapi": "npm run build && node scripts/gen-openapi.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@casl/ability": "^6.7.2",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.29",
    "@noble/hashes": "1.8.0",
    "argon2": "0.45.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "countries-list": "^3.4.1",
    "decimal.js": "10.4.3",
    "dotenv": "^17.4.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "libphonenumber-js": "1.13.10",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.13",
    "openai": "7.28.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "js-yaml": "^5.2.3",
    "multer": "^2.3.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "./scripts/gate-file.sh"
    ]
  }
}
