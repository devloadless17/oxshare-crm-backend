# App
PORT=3001
NODE_ENV=development

# CORS — allow both frontends
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://user:password@localhost:5432/bbcorp_crm

# Redis (BullMQ + OTP)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible storage (KYC docs — private bucket, signed URLs only)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bbcorp-kyc-docs
S3_REGION=us-east-1

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bbcorp.com

# MT5 Bridge (Windows Server — mTLS or shared secret)
MT5_BRIDGE_URL=http://localhost:5000
MT5_BRIDGE_SECRET=change-me-bridge-secret

# Payment providers
WHISH_API_KEY=
WHISH_WEBHOOK_SECRET=
USDT_NODE_URL=
USDT_CONFIRMATION_DEPTH=6
