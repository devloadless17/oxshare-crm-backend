# OxShare CRM backend — environment template
# Copy to .env and fill in. Validated at boot (src/config/env.validation.ts):
# the process refuses to start on invalid config, and production refuses to
# start without DATABASE_URL and all four JWT secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend origins (CORS + links in emails) ────────────────────────────────
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ── Realtime (WebSocket) ──────────────────────────────────────────────────────
# The socket runs on uWebSockets.js, which needs its OWN port: Nest serves HTTP
# through Express and one TCP port has one listener. Set REALTIME_ENGINE=node to
# attach the socket to PORT above instead — the one-variable revert.
#
# In production this must stay on the SAME HOSTNAME as the API. Session cookies
# ignore the port, but `__Host-` cookies are host-scoped, so a realtime
# subdomain would receive no cookie and refuse every handshake.
REALTIME_ENGINE=uws
REALTIME_PORT=3003

# Where THIS API is publicly reachable. Payment providers call back to it, so it
# must be a real public host — a provider cannot reach `localhost`.
#
# For local Whish testing, run a tunnel (ngrok/cloudflared) at this API and put
# the tunnel URL here. Without it the provider callback never lands; the client's
# own browser redirect still settles the deposit, so the flow degrades rather
# than breaks — but do not run production on one of the two paths.
API_PUBLIC_URL=http://localhost:3001

# ── Whish Money — the hosted payment gateway (deposits) ──────────────────────
# All four together or none: with any missing, the Whish method is not offered
# to clients at all, exactly as a manual method with no pay-to is not offered.
# A gateway nobody can reach must not appear on the deposit screen.
#
# ⚠️ `WHISH_SECRET` authorises money collection against the operator's own Whish
# account. It is a bearer credential — secrets manager only, never client-side,
# never in a log line.
#
# WHISH_WEBSITE_URL must be the EXACT value Whish issued with the keys; Whish
# matches it against the credential pair and refuses a plausible substitution
# with an opaque code.
#
# WHISH_BASE_URL is chosen explicitly rather than derived from NODE_ENV, so a
# staging deployment cannot silently point at the LIVE money API.
#   Sandbox:    https://partner.api.sbx.whish.money/itel-service/api
#   Production: https://api.whish.money/itel-service/api
#
# Sandbox test values: phone 96170123456, OTP 111111. Any other OTP triggers the
# failure callback while leaving the payment link payable.
#
# NOTE: Whish has no payout API. It collects and refunds only, so WITHDRAWALS
# stay on the manual admin-approval path — there is no way to send money out.
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=
WHISH_BASE_URL=https://partner.api.sbx.whish.money/itel-service/api

# ── Database (unused until the Postgres/Drizzle milestone; required in prod) ─
# Local dev: `docker compose up -d` starts Postgres 16 with exactly these creds.
# The shared Neon instance is staging/demo only — keep its URL commented here.
DATABASE_URL=postgresql://oxshare:oxshare_dev@localhost:5432/oxshare

# ── JWT secrets — FOUR DISTINCT values, min 32 chars each ────────────────────
# One key per (surface x token kind):
#   ADMIN_JWT_SECRET          admin  access   (15m)
#   ADMIN_JWT_REFRESH_SECRET  admin  refresh  (30d)
#   JWT_ACCESS_SECRET         portal access   (15m)
#   JWT_REFRESH_SECRET        portal refresh  (30d)
#
# All four are REQUIRED in every environment — there are no dev fallbacks, and a
# missing one refuses the boot rather than signing with a constant from this repo.
# They must also all DIFFER: reusing one silently removes the separation it
# exists to create, and env.validation.ts refuses to start if any two match.
# Generate with:  openssl rand -base64 48
#
# (There is NO "JWT_SECRET" — that name is read by nothing.)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── SMTP (dev: use an Ethereal test account from https://ethereal.email) ─────
#
# These are the BOOTSTRAP mail settings. Settings → Email in the admin console
# overrides all five at runtime, and the row it writes wins whole. They are still
# required in production: the override cannot exist before somebody signs in to
# create it, so a fresh deployment needs these to send the admin-invite email
# that produces the first administrator.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# NOTE: quote the whole value (docker compose also parses this file):
SMTP_FROM='"OxShare System" <no-reply@oxshare.com>'

# ── Encryption key for secrets stored at rest ────────────────────────────────
# Currently the SMTP password saved from Settings → Email, which is encrypted
# with AES-256-GCM (see src/common/security/secret-box.ts).
#
# Generate one with:  openssl rand -base64 48
#
# There is deliberately no built-in default — one would be published in this
# repository and shared by every deployment that forgot to set it. Without it the
# settings screen refuses to store a password, and production refuses to boot.
#
# CHANGING IT makes an already-stored SMTP password unreadable. The system keeps
# working (it falls back to connecting unauthenticated and logs why); re-enter
# the password in the admin console to store it again under the new key.
APP_ENCRYPTION_KEY=

# ── Testing without a real mailbox ───────────────────────────────────────────
# There is no longer a way to echo emailed credentials to the terminal.
#
# `MAIL_DEV_ECHO` printed verification, password-reset and admin-invite links so
# those flows could be tested without SMTP. It was removed from the code — the
# variable is READ BY NOTHING now, so setting it does nothing at all, and the
# refusal-to-boot that used to stop it reaching production went with it.
#
# It is documented here as ABSENT rather than deleted silently, because this file
# advertised both the flag and that production guard for a while after neither
# existed — which is worse than no documentation: it describes a protection
# somebody may rely on.
#
# IF IT COMES BACK: the production check must come back with it. These are bearer
# credentials — an invite link alone creates an admin account on a system that
# approves withdrawals — so a copied .env carrying the flag into production has
# to fail the deploy loudly rather than quietly logging credentials.
#
# To test an email flow today, point SMTP_* at a local catcher (Mailpit, MailHog).

# ── Not consumed yet (future milestones, per ARCHITECTURE) ───────────────────
# Redis. Single-use replay markers for signed webhooks live here (§8.4, R-5.3):
# without it a signed endpoint REFUSES requests rather than accepting ones it
# cannot check. Also the future BullMQ backend.
REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=                              # KYC document storage + signed URLs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=oxshare-kyc-docs
# S3_REGION=us-east-1
# WHISH_API_KEY=                            # payments
# WHISH_WEBHOOK_SECRET=
# USDT_NODE_URL=
# USDT_CONFIRMATION_DEPTH=6

# ── MT5 bridge (ARCHITECTURE §3.1) ────────────────────────────────────────────
# The Manager API is a native Windows library and cannot be called from Node, so
# a small ASP.NET Core service wraps it and this API talks to that over HTTP.
# See ../bridge.
#
# TWO SECRETS, in opposite directions, and they are not interchangeable:
#   MT5_BRIDGE_API_KEY  this API  -> the bridge   (sent as X-Bridge-Key)
#   MT5_BRIDGE_SECRET   the bridge -> this API    (checked on the deals webhook)
# Reusing one for both would mean a leak in either direction compromises both.
#
# Unset is a supported state: the CRM runs without a bridge, and every call to it
# raises a stated error rather than pretending an account was created. The
# webhook DENIES when MT5_BRIDGE_SECRET is unset, so a forgotten variable cannot
# leave ledger ingestion open.
# MT5_BRIDGE_URL=http://10.0.0.8:5000
# MT5_BRIDGE_API_KEY=
# MT5_BRIDGE_SECRET=
# MT5_BRIDGE_TIMEOUT_MS=30000
#
# ── Self-service account opening (portal) ─────────────────────────────────────
# Which MT5 groups a CLIENT may open an account in — a comma-separated LIST of
# the products the broker sells online. A client picks one from it and cannot
# reach any other group on the server; the currency of each is read live from
# MT5 rather than configured here, so what the portal shows is what the account
# will actually be denominated in.
#
# UNSET MEANS THAT DOOR IS CLOSED. The portal asks
# GET /trading/accounts/self-service and hides the button for an environment
# with no groups, rather than offering something the API will refuse. So leaving
# both blank is a working configuration meaning "no self-service", and NOT a
# broken one — if the portal shows no "Open account" button, this is why.
#
# Ask the broker which groups are for self-registered clients; do not guess.
# MT5_CLIENT_GROUPS_LIVE=real\Standard,real\ECN
# MT5_CLIENT_GROUPS_DEMO=demo\Standard
#
# The singular MT5_CLIENT_GROUP_LIVE / _DEMO are still read as a fallback, so a
# deployment configured before the list existed keeps working.
#
# EVERYTHING ELSE ABOUT ACCOUNT OPENING IS A DATABASE SETTING, not a variable:
# the leverage ladder, how many accounts one client may open of each kind, and
# the largest demo starting balance all live in `trading_settings` and are
# edited at Settings → Trading in the admin console. They are commercial
# decisions that change without a deploy.
#
# MT5_CLIENT_LEVERAGES is the one exception, and only as a SEED: it is read when
# no row exists yet, so an older deployment keeps offering what it offered
# yesterday. After the first save in that tab, the table is the only answer and
# this variable is ignored.
# MT5_CLIENT_LEVERAGES=50,100,200,500
