# OxShare CRM backend — environment template
# Copy to .env and fill in. Validated at boot (src/config/env.validation.ts):
# the process refuses to start on invalid config, and production refuses to
# start without DATABASE_URL and all three JWT secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend origins (CORS + links in emails) ────────────────────────────────
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ── Database (unused until the Postgres/Drizzle milestone; required in prod) ─
# Local dev: `docker compose up -d` starts Postgres 16 with exactly these creds.
# The shared Neon instance is staging/demo only — keep its URL commented here.
DATABASE_URL=postgresql://oxshare:oxshare_dev@localhost:5432/oxshare

# ── JWT secrets — three DISTINCT values, min 32 chars each ───────────────────
# ADMIN_JWT_SECRET signs admin tokens; JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
# sign client-portal tokens. (There is NO "JWT_SECRET" — that name is not read.)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── SMTP (dev: use an Ethereal test account from https://ethereal.email) ─────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# NOTE: quote the whole value (docker compose also parses this file):
SMTP_FROM='"OxShare System" <no-reply@oxshare.com>'

# ── Not consumed yet (future milestones, per ARCHITECTURE) ───────────────────
# REDIS_URL=redis://localhost:6379          # BullMQ queues
# S3_ENDPOINT=                              # KYC document storage + signed URLs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=oxshare-kyc-docs
# S3_REGION=us-east-1
# MT5_BRIDGE_URL=http://localhost:5000      # MT5 bridge stub
# MT5_BRIDGE_SECRET=
# WHISH_API_KEY=                            # payments
# WHISH_WEBHOOK_SECRET=
# USDT_NODE_URL=
# USDT_CONFIRMATION_DEPTH=6
