# OxShare CRM backend — environment template
# Copy to .env and fill in. Validated at boot (src/config/env.validation.ts):
# the process refuses to start on invalid config, and production refuses to
# start without DATABASE_URL and all four JWT secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend origins (CORS + links in emails) ────────────────────────────────
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ── Database (unused until the Postgres/Drizzle milestone; required in prod) ─
# Local dev: `docker compose up -d` starts Postgres 16 with exactly these creds.
# The shared Neon instance is staging/demo only — keep its URL commented here.
DATABASE_URL=postgresql://oxshare:oxshare_dev@localhost:5432/oxshare

# ── JWT secrets — FOUR DISTINCT values, min 32 chars each ────────────────────
# One key per (surface x token kind):
#   ADMIN_JWT_SECRET          admin  access   (15m)
#   ADMIN_JWT_REFRESH_SECRET  admin  refresh  (30d)
#   JWT_ACCESS_SECRET         portal access   (15m)
#   JWT_REFRESH_SECRET        portal refresh  (30d)
#
# All four are REQUIRED in every environment — there are no dev fallbacks, and a
# missing one refuses the boot rather than signing with a constant from this repo.
# They must also all DIFFER: reusing one silently removes the separation it
# exists to create, and env.validation.ts refuses to start if any two match.
# Generate with:  openssl rand -base64 48
#
# (There is NO "JWT_SECRET" — that name is read by nothing.)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── SMTP (dev: use an Ethereal test account from https://ethereal.email) ─────
#
# These are the BOOTSTRAP mail settings. Settings → Email in the admin console
# overrides all five at runtime, and the row it writes wins whole. They are still
# required in production: the override cannot exist before somebody signs in to
# create it, so a fresh deployment needs these to send the admin-invite email
# that produces the first administrator.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# NOTE: quote the whole value (docker compose also parses this file):
SMTP_FROM='"OxShare System" <no-reply@oxshare.com>'

# ── Encryption key for secrets stored at rest ────────────────────────────────
# Currently the SMTP password saved from Settings → Email, which is encrypted
# with AES-256-GCM (see src/common/security/secret-box.ts).
#
# Generate one with:  openssl rand -base64 48
#
# There is deliberately no built-in default — one would be published in this
# repository and shared by every deployment that forgot to set it. Without it the
# settings screen refuses to store a password, and production refuses to boot.
#
# CHANGING IT makes an already-stored SMTP password unreadable. The system keeps
# working (it falls back to connecting unauthenticated and logs why); re-enter
# the password in the admin console to store it again under the new key.
APP_ENCRYPTION_KEY=

# ── Testing without a real mailbox ───────────────────────────────────────────
# Prints the verification link, password-reset link, admin-invite link and
# withdrawal OTP to the backend terminal, so registration, invites and OTP can be
# tested with no working SMTP server.
#
# These are BEARER CREDENTIALS — an invite link alone creates an admin account on
# a system that approves withdrawals — so they are not logged by default, and the
# app REFUSES TO START if this is set with NODE_ENV=production.
#
# Leave it unset unless you are actively testing an email flow locally.
MAIL_DEV_ECHO=true

# ── Not consumed yet (future milestones, per ARCHITECTURE) ───────────────────
# Redis. REQUIRED wherever MT5_BRIDGE_SECRET is set — the deal feed's single-use
# replay markers live here (§8.4, R-5.3), and the app refuses to start without it
# rather than accepting webhooks it cannot check. Also the future BullMQ backend.
REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=                              # KYC document storage + signed URLs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=oxshare-kyc-docs
# S3_REGION=us-east-1
# ── MT5 bridge ───────────────────────────────────────────────────────────────
# Shared secret for BOTH the X-Bridge-Token header and the HMAC-SHA256
# signature over the raw webhook body. Without it the deal webhook refuses
# every request — an unauthenticated deal feed can mint commission.
MT5_BRIDGE_SECRET=
# MT5_BRIDGE_URL=http://localhost:5000      # bridge base URL (outbound calls)
# WHISH_API_KEY=                            # payments
# WHISH_WEBHOOK_SECRET=
# USDT_NODE_URL=
# USDT_CONFIRMATION_DEPTH=6
