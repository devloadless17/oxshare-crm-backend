# TLS termination and the only thing on this VPS listening to the internet.
# Both API_DOMAIN and ACME_EMAIL come from the environment (docker-compose.prod.yml).

{
	# So Let's Encrypt has somewhere to send expiry and revocation notices. ACME
	# registration succeeds without it, and then nobody is told when something is
	# wrong with a certificate.
	email {$ACME_EMAIL}

# ── Which API version receives traffic ──────────────────────────────────────────
#
# deploy/release.sh writes active-api.caddy (one `reverse_proxy` to the live colour,
# api_blue or api_green; the port is the import's argument), validates it, then
# reloads Caddy gracefully. A release therefore switches traffic without
# dropping a connection, and the old version drains only after the new one serves.


	# HTTP/3 is on (Caddy's default: h1 h2 h3). UDP/443 delivery was measured on
	# 17 Aug 2026 — a listener in a container publishing 443/udp received probes
	# from the public internet — so advertising `alt-svc: h3=":443"` is safe. If
	# this VPS ever moves to a host that drops UDP/443, pin `servers { protocols
	# h1 h2 }` here AND remove `443:443/udp` from docker-compose.prod.yml,
	# together: browsers cache alt-svc for 30 days, and h3 advertised over a dead
	# UDP path gives mobile users intermittent ERR_CONNECTION_RESET.

	# ── Who is the caller? Trust by ADDRESS, never by counting hops ──────────
	#
	# The domain is behind Cloudflare (orange cloud) since 11 Oct 2026, so the
	# machine connecting here is usually Cloudflare's, not the client's. Caddy
	# believes the client address a connection REPORTS (X-Forwarded-For) only
	# when the connection itself comes from one of Cloudflare's published ranges
	# below. From anywhere else — a client still reaching this server directly,
	# or somebody who found its address — the header is ignored and the socket
	# address is the client, so nobody can choose their own address.
	#
	# The ranges are https://www.cloudflare.com/ips-v4 and /ips-v6 (read 11 Oct
	# 2026; they change about once in several years). A range missing here fails
	# SAFE: its requests are counted under Cloudflare's address, as before, and
	# src/common/security/proxy-depth.ts never sees a forged one.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# X-Forwarded-For, read from the RIGHT and stopping at the first machine
		# that is not trusted (`strict`). Not CF-Connecting-IP: that header is only
		# true when Cloudflare itself is the connecting machine, and would be a
		# caller's to forge the day a load balancer stands between the two.
		trusted_proxies_strict
	}
}

{$API_DOMAIN} {
	# ── One hostname, two upstreams ──────────────────────────────────────────
	#
	# The realtime engine is a SECOND TCP listener: REALTIME_ENGINE=uws runs
	# Socket.IO on uWebSockets.js, which owns :3003 while Nest keeps :3001.
	#
	# Both must answer on the SAME HOSTNAME. Session cookies carry the `__Host-`
	# prefix, which scopes them to one host and ignores the port — so a
	# `realtime.` subdomain would receive no cookie and every handshake would be
	# refused, with a `logger.warn` as the only trace. Splitting by PATH is what
	# keeps the cookie in play.
	#
	# `/socket.io/*` is the right prefix: REALTIME_NAMESPACE = '/realtime' in the
	# gateway is a Socket.IO namespace multiplexed inside the packet, not a URL
	# segment, and the server keeps the default `/socket.io` path.
	handle /socket.io/* {
		# Caddy v2 upgrades WebSockets with no extra configuration, and passes
		# Origin through untouched — which the gateway compares by exact string
		# equality against PORTAL_URL / ADMIN_URL.
		import /etc/caddy/active-api.caddy 3003
	}

	# The bridge's endpoints are NOT on the public site. The bridge reaches them
	# through the WireGuard tunnel (the site block at the end), so from the
	# internet they do not exist. The longer path wins over the catch-all below.
	handle /v1/webhooks/mt5/* {
		respond 404
	}

	handle {
		import /etc/caddy/active-api.caddy 3001
	}

	# The API is handed exactly ONE address in X-Forwarded-For: the client Caddy
	# resolved above (active-api.caddy sets it from {client_ip}). That is what
	# TRUSTED_PROXY_HOPS=1 in the rendered .env refers to, and it stays 1 whether
	# a request came through Cloudflare or straight here. It was read as the
	# CONNECTING address until 11 Oct 2026: when Cloudflare was switched on, every
	# client behind it became one address, and the sign-up limit refused them all.
	# Another proxy in front of this one (a load balancer, a second CDN) is added
	# to `trusted_proxies` above — the count does not change.

	encode zstd gzip

	log {
		output stdout
		format json
	}
}

# ── The bridge's door: on the WireGuard tunnel ONLY ─────────────────────────────
#
# The MT5 bridge (Contabo, 10.8.0.2) posts deals, balances and live readings here,
# and reads its sweep settings, over the tunnel: Crm:BaseUrl = http://10.8.0.1:8080.
# Plain HTTP, because WireGuard already encrypts and authenticates both machines;
# X-Bridge-Secret is still checked by the API, as a second lock. Published on the
# tunnel address only (docker-compose.prod.yml), so nothing on the internet can
# reach it, and only the bridge's paths are served.
http://10.8.0.1:8080 {
	handle /v1/webhooks/mt5/* {
		import /etc/caddy/active-api.caddy 3001
	}
	respond 404
}
